{
    "name": "xDiT",
    "image": "cog-hunyuanvideo-community:latest",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "python.pythonPath": "/usr/local/bin/python",
                "terminal.integrated.shell.linux": "/bin/zsh"
            }
        }
    },
	"containerEnv": {
		"NVIDIA_VISIBLE_DEVICES": "6,7"
	},
	"runArgs": [
		"--gpus=all",
		"--shm-size=16G",
		"--ulimit",
		"memlock=-1"
	]
}